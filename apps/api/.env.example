# PlanLedger Django Backend Environment Configuration

# Django Core
SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# For local Docker: postgresql://postgres:postgres@localhost:5432/planledger
# For Neon PostgreSQL: postgresql://user:password@ep-sample-pooler.region.neon.tech/planledger?sslmode=require
# If left empty, SQLite (db.sqlite3) is used automatically for zero-friction local development & tests.
DATABASE_URL=

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration
# Options: 'console' (local default) or 'smtp' (production relay via Brevo)
EMAIL_BACKEND_TYPE=console
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@planledger.brightloop.io
